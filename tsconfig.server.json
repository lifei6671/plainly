{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "target": "ES2020",
    "moduleResolution": "Node16",
    "rootDir": "src",
    "outDir": "dist-server",
    "noEmit": false,
    "declaration": false
  },
  "include": ["src/server/**/*.ts"],
  "exclude": ["node_modules", "src/**/*.test.ts"]
}
